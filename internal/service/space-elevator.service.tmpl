[Unit]
Description=space-elevator dashboard (Podman-first deployment tool)
Wants=network-online.target podman.socket
After=network-online.target podman.socket

[Service]
ExecStart={{.BinPath}} serve --addr {{.Addr}}
# "always" (not on-failure): a dashboard must come back up even after a
# clean SIGTERM — a stray kill would otherwise leave it dead for good.
Restart=always
RestartSec=3
# State (SQLite DB, CSRF key) and apps root live under the home dir;
# the unit only needs normal user access.
NoNewPrivileges=true
{{- if .EnvFile}}
EnvironmentFile=-{{.EnvFile}}
{{- end}}

[Install]
WantedBy=default.target
